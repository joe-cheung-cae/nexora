{
  "version": 5,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 25,
    "patch": 2
  },
  "configurePresets": [
    {
      "name": "base",
      "hidden": true,
      "generator": "Ninja",
      "binaryDir": "${sourceDir}/build/${presetName}",
      "cacheVariables": {
        "BUILD_TESTING": "ON",
        "CMAKE_CXX_EXTENSIONS": "OFF",
        "CMAKE_CXX_STANDARD": "20",
        "CMAKE_CXX_STANDARD_REQUIRED": "ON",
        "NEXORA_ENABLE_DOUBLE_PRECISION": "OFF",
        "NEXORA_ENABLE_MPI": "OFF"
      }
    },
    {
      "name": "cpu-debug",
      "displayName": "CPU Debug",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Debug" }
    },
    {
      "name": "cpu-release",
      "displayName": "CPU Release",
      "inherits": "base",
      "cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
    },
    {
      "name": "mpi-debug",
      "displayName": "CPU with MPI C API probe",
      "inherits": "cpu-debug",
      "cacheVariables": { "NEXORA_ENABLE_MPI": "ON" }
    }
  ],
  "buildPresets": [
    { "name": "cpu-debug", "configurePreset": "cpu-debug" },
    { "name": "cpu-release", "configurePreset": "cpu-release" },
    { "name": "mpi-debug", "configurePreset": "mpi-debug" }
  ],
  "testPresets": [
    {
      "name": "test-defaults",
      "hidden": true,
      "output": { "outputOnFailure": true },
      "execution": { "noTestsAction": "error" }
    },
    { "name": "cpu-debug", "configurePreset": "cpu-debug", "inherits": "test-defaults" },
    { "name": "cpu-release", "configurePreset": "cpu-release", "inherits": "test-defaults" },
    { "name": "mpi-debug", "configurePreset": "mpi-debug", "inherits": "test-defaults" }
  ]
}
