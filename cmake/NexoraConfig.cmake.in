@PACKAGE_INIT@

include(CMakeFindDependencyMacro)
set(Kokkos_LAUNCH_COMPILER OFF)
find_dependency(Kokkos 5.2.2 EXACT CONFIG)
include("${CMAKE_CURRENT_LIST_DIR}/NexoraKokkos.cmake")
nexora_validate_kokkos()
if(NOT CMAKE_CXX_COMPILER_ID STREQUAL "@CMAKE_CXX_COMPILER_ID@"
   OR NOT CMAKE_CXX_COMPILER_VERSION VERSION_EQUAL "@CMAKE_CXX_COMPILER_VERSION@")
    message(FATAL_ERROR "This Nexora installation requires @CMAKE_CXX_COMPILER_ID@ @CMAKE_CXX_COMPILER_VERSION@; select the matching compiler and Kokkos package.")
endif()
foreach(property IN ITEMS ARCH OPTIONS TPLS)
    set(expected "")
    if(property STREQUAL "ARCH")
        set(expected "@Kokkos_ARCH@")
    elseif(property STREQUAL "OPTIONS")
        set(expected "@Kokkos_OPTIONS@")
    elseif(property STREQUAL "TPLS")
        set(expected "@Kokkos_TPLS@")
    endif()
    set(actual "${Kokkos_${property}}")
    list(SORT expected)
    list(SORT actual)
    if(NOT actual STREQUAL expected)
        message(FATAL_ERROR "Nexora requires the installed Kokkos ${property} profile '${expected}', found '${actual}'.")
    endif()
endforeach()
include("${CMAKE_CURRENT_LIST_DIR}/NexoraTargets.cmake")
check_required_components(Nexora)
