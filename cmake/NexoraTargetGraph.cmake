# Capture direct edges after all project directories have declared their targets.
function(nexora_collect_targets directory output)
    get_property(targets DIRECTORY "${directory}" PROPERTY BUILDSYSTEM_TARGETS)
    get_property(children DIRECTORY "${directory}" PROPERTY SUBDIRECTORIES)
    foreach(child IN LISTS children)
        nexora_collect_targets("${child}" child_targets)
        list(APPEND targets ${child_targets})
    endforeach()
    set("${output}" "${targets}" PARENT_SCOPE)
endfunction()

function(nexora_json_string input output)
    string(REPLACE "\\" "\\\\" escaped "${input}")
    string(REPLACE "\"" "\\\"" escaped "${escaped}")
    set("${output}" "\"${escaped}\"" PARENT_SCOPE)
endfunction()

function(nexora_write_target_graph path)
    nexora_collect_targets("${PROJECT_SOURCE_DIR}" targets)
    set(entries "")
    foreach(target IN LISTS targets)
        get_property(type TARGET "${target}" PROPERTY TYPE)
        if(type STREQUAL "UTILITY")
            continue()
        endif()

        get_property(links TARGET "${target}" PROPERTY LINK_LIBRARIES)
        get_property(interface_links TARGET "${target}" PROPERTY INTERFACE_LINK_LIBRARIES)
        list(APPEND links ${interface_links})
        set(edges "")
        foreach(link IN LISTS links)
            # CMake wraps a static library's private export dependencies this way.
            string(REGEX REPLACE "^\\$<LINK_ONLY:([^<>]+)>$" "\\1" link "${link}")
            if(TARGET "${link}")
                get_property(alias TARGET "${link}" PROPERTY ALIASED_TARGET)
                if(alias)
                    set(link "${alias}")
                endif()
            endif()
            nexora_json_string("${link}" quoted_link)
            list(APPEND edges "${quoted_link}")
        endforeach()
        list(REMOVE_DUPLICATES edges)
        list(JOIN edges ", " edge_list)

        get_property(target_dir TARGET "${target}" PROPERTY SOURCE_DIR)
        file(RELATIVE_PATH relative_dir "${PROJECT_SOURCE_DIR}" "${target_dir}")
        nexora_json_string("${target}" quoted_target)
        nexora_json_string("${relative_dir}" quoted_dir)
        list(APPEND entries
            "    {\"name\": ${quoted_target}, \"source_dir\": ${quoted_dir}, \"links\": [${edge_list}]}")
    endforeach()
    list(JOIN entries ",\n" entry_list)
    set(testing_enabled false)
    if(BUILD_TESTING)
        set(testing_enabled true)
    endif()
    file(WRITE "${path}" "{\"testing_enabled\": ${testing_enabled}, \"targets\": [\n${entry_list}\n]}\n")
endfunction()
